---
import { getCollection, type CollectionEntry } from 'astro:content';
import Faq from '../../components/Faq.astro';
import Ingredients from '../../components/Ingredients.astro';
import PriceTable from '../../components/PriceTable.astro';
import Usage from '../../components/Usage.astro';
import { pages } from '../../config/pages';
import { site, whatsappLink } from '../../config/site';
import PageLayout from '../../layouts/PageLayout.astro';
import { assetUrl } from '../../lib/paths';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'products'>;
}

const { entry } = Astro.props;
const product = entry.data;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  brand: { '@type': 'Brand', name: product.manufacturer },
  description: product.seo.description,
  ...(pageUrl && { url: pageUrl }),
  ...(Astro.site && {
    image: new URL(assetUrl(product.images.hero.src), Astro.site).href,
  }),
  offers: product.presentations.map((p) => ({
    '@type': 'Offer',
    name: `${product.name} ${p.label}`,
    price: p.price.toFixed(2),
    priceCurrency: site.currency,
    ...(pageUrl && { url: pageUrl }),
  })),
};
---

<PageLayout
  title={`${product.name} | ${product.manufacturer}`}
  description={product.seo.description}
  crumb={product.name}
  jsonLd={jsonLd}
>
  <section class="section product-detail" aria-labelledby="product-title">
    <div class="product-detail-grid">
      <div class="product-card" data-tilt>
        <img
          src={assetUrl(product.images.hero.src)}
          alt={product.images.hero.alt}
          width={product.images.hero.width}
          height={product.images.hero.height}
          fetchpriority="high"
        />
      </div>
      <div class="product-info">
        <span class="eyebrow">{product.manufacturer}</span>
        <h1 id="product-title">{product.name}</h1>
        <p>{product.intro}</p>
        {product.summary.verified && <p>{product.summary.text}</p>}

        <h2 class="product-subtitle">Presentación y precios</h2>
        <PriceTable product={product} />
        <p class="footnote">
          Envío por Shalom u Olva, o recojo en Lima. El costo depende de la zona o del destino y se
          confirma por WhatsApp. <a href={pages.shipping}>Ver envíos y pagos</a>.
        </p>

        <div class="hero-actions">
          <a class="btn primary" href={pages.order}>
            Hacer pedido
          </a>
          <a
            class="btn ghost"
            href={whatsappLink(`Hola, quiero información sobre ${product.name}.`)}
            target="_blank"
            rel="noopener"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
  <Ingredients product={product} />
  <Usage product={product} />
  <Faq product={product} />
</PageLayout>
