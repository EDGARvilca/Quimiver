---
import LegalData from '../components/LegalData.astro';
import { pages } from '../config/pages';
import { complaintsBookEnabled, site } from '../config/site';
import PageLayout from '../layouts/PageLayout.astro';
import {
  DOCUMENT_TYPES,
  LEGENDS,
  RESPONSE_DEADLINE_BUSINESS_DAYS,
} from '../../supabase/functions/libro-reclamaciones/complaint';

const config = { endpoint: site.complaintsBook.endpoint, email: site.contact.email };
---

<PageLayout
  title={`Libro de Reclamaciones | ${site.brand}`}
  description={`Libro de Reclamaciones virtual de ${site.brand}: registra un reclamo o una queja y recibe la copia en tu correo.`}
  crumb="Libro de Reclamaciones"
>
  <section class="section info-page complaints" aria-labelledby="page-title">
    <span class="eyebrow">Atención al consumidor</span>
    <h1 id="page-title">Libro de Reclamaciones</h1>
    <p class="lead">
      Conforme a lo establecido en el Código de Protección y Defensa del Consumidor (Ley N.° 29571),
      {site.company} cuenta con un Libro de Reclamaciones virtual a tu disposición. Al enviar la
      hoja recibirás su número y una copia en tu correo.
    </p>

    {!complaintsBookEnabled && (
      <p class="form-status" data-kind="error">
        El libro virtual se habilitará en cuanto completemos nuestros datos legales. Mientras tanto,
        escríbenos a <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> y atenderemos
        tu reclamo.
      </p>
    )}

    <div class="complaints-provider">
      <h2>Proveedor</h2>
      <LegalData />
      <p class="footnote">La fecha y la hora de la hoja se registran al enviarla.</p>
    </div>

    <div class="complaints-legends">
      <p>{LEGENDS.reclamo}</p>
      <p>{LEGENDS.queja}</p>
    </div>

    <form class="order-form complaints-form" id="complaints-form" novalidate>
      <fieldset>
        <legend>1. Tus datos</legend>
        <div class="form-field full">
          <label for="consumidor_nombre">Nombre y apellidos</label>
          <input id="consumidor_nombre" name="consumidor_nombre" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="documento_tipo">Documento</label>
          <select id="documento_tipo" name="documento_tipo" required>
            {DOCUMENT_TYPES.map((d) => (
              <option value={d}>{d}</option>
            ))}
          </select>
        </div>
        <div class="form-field">
          <label for="documento_numero">Número de documento</label>
          <input id="documento_numero" name="documento_numero" required inputmode="text" />
        </div>
        <div class="form-field full">
          <label for="domicilio">Domicilio</label>
          <input
            id="domicilio"
            name="domicilio"
            required
            autocomplete="street-address"
            placeholder="Dirección, distrito y provincia"
          />
        </div>
        <div class="form-field">
          <label for="telefono">Teléfono</label>
          <input id="telefono" name="telefono" type="tel" required autocomplete="tel" />
        </div>
        <div class="form-field">
          <label for="correo">Correo electrónico</label>
          <input id="correo" name="correo" type="email" required autocomplete="email" />
        </div>
        <div class="form-field full form-consent">
          <input type="checkbox" id="menor_de_edad" name="menor_de_edad" />
          <label for="menor_de_edad">Soy menor de edad</label>
        </div>
        <div class="form-field full" id="apoderado-field" hidden>
          <label for="apoderado_nombre">Nombre del padre, madre o apoderado</label>
          <input id="apoderado_nombre" name="apoderado_nombre" />
        </div>
      </fieldset>

      <fieldset>
        <legend>2. Producto o servicio</legend>
        <div class="form-field full choice-row" role="radiogroup" aria-labelledby="bien-label">
          <span id="bien-label" class="choice-label">
            Se trata de
          </span>
          <label>
            <input type="radio" name="bien_tipo" value="producto" checked /> Producto
          </label>
          <label>
            <input type="radio" name="bien_tipo" value="servicio" /> Servicio
          </label>
        </div>
        <div class="form-field">
          <label for="monto">Monto reclamado (S/, opcional)</label>
          <input id="monto" name="monto" inputmode="decimal" placeholder="25.00" />
        </div>
        <div class="form-field">
          <label for="numero_pedido">N.º de pedido o comprobante (opcional)</label>
          <input id="numero_pedido" name="numero_pedido" />
        </div>
        <div class="form-field full">
          <label for="bien_descripcion">Descripción</label>
          <input
            id="bien_descripcion"
            name="bien_descripcion"
            required
            value={`${site.brand}, frasco de 50 g`}
          />
        </div>
      </fieldset>

      <fieldset>
        <legend>3. Detalle</legend>
        <div class="form-field full choice-row" role="radiogroup" aria-labelledby="tipo-label">
          <span id="tipo-label" class="choice-label">
            Tipo
          </span>
          <label>
            <input type="radio" name="tipo" value="reclamo" checked /> Reclamo
          </label>
          <label>
            <input type="radio" name="tipo" value="queja" /> Queja
          </label>
        </div>
        <div class="form-field full">
          <label for="detalle">¿Qué pasó?</label>
          <textarea id="detalle" name="detalle" rows="5" required maxlength="3000"></textarea>
        </div>
        <div class="form-field full">
          <label for="pedido">¿Qué solicitas?</label>
          <textarea id="pedido" name="pedido" rows="3" required maxlength="1500"></textarea>
        </div>
      </fieldset>

      <div class="visually-hidden" aria-hidden="true">
        <label for="sitio_web">No llenar</label>
        <input id="sitio_web" name="sitio_web" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-field full form-consent">
        <input type="checkbox" id="complaints-consent" name="consent" required />
        <label for="complaints-consent">
          Acepto que {site.company} use mis datos para atender este reclamo o queja, según la{' '}
          <a class="text-link" href={pages.privacy} target="_blank" rel="noopener">
            política de privacidad
          </a>
          .
        </label>
      </div>

      <p id="complaints-status" class="form-status" role="status" aria-live="polite" hidden></p>

      <button type="submit" class="btn primary full">
        Enviar hoja de reclamación
      </button>
    </form>

    <div id="complaints-receipt" class="complaints-receipt" hidden tabindex="-1">
      <h2>Hoja registrada</h2>
      <p id="complaints-receipt-note"></p>
      <table class="complaints-table">
        <caption class="visually-hidden">Copia de tu hoja de reclamación</caption>
        <tbody id="complaints-receipt-rows"></tbody>
      </table>
      <button type="button" class="btn ghost" id="complaints-print">
        Imprimir o guardar en PDF
      </button>
    </div>

    <div class="complaints-legends">
      <p>{LEGENDS.plazo}</p>
      <p>{LEGENDS.indecopi}</p>
      <p>
        Responderemos en un plazo no mayor a {RESPONSE_DEADLINE_BUSINESS_DAYS} días hábiles al
        correo que indiques. Las observaciones y acciones adoptadas por el proveedor se registran en
        tu hoja al responder.
      </p>
    </div>
  </section>
  <script type="application/json" id="complaints-config" set:html={JSON.stringify(config)} />
</PageLayout>

<script>
  import { initComplaintsForm } from '../scripts/complaints-form';
  initComplaintsForm();
</script>
