---
import { site } from '../config/site';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title={`Panel de pedidos | ${site.brand}`}
  description="Panel privado para revisar los pedidos de la tienda."
  crumb="Panel de pedidos"
  noindex
>
  <section class="section info-page panel" aria-labelledby="page-title">
    <span class="eyebrow">Uso interno</span>
    <h1 id="page-title">Panel de pedidos</h1>

    <form class="order-form panel-login" id="panel-login">
      <p class="lead">Entra con el correo y la contraseña de administrador.</p>
      <div class="form-field full">
        <label for="panel-email">Correo</label>
        <input id="panel-email" name="email" type="email" required autocomplete="username" />
      </div>
      <div class="form-field full">
        <label for="panel-password">Contraseña</label>
        <input
          id="panel-password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        />
      </div>
      <button type="submit" class="btn primary full">
        Entrar
      </button>
      <p class="form-status" id="panel-login-status" role="status" hidden></p>
    </form>

    <div class="panel-board" id="panel-board" hidden>
      <section class="panel-stock" aria-labelledby="panel-stock-title">
        <div class="panel-stock-head">
          <h2 id="panel-stock-title">Stock</h2>
          <p class="panel-stock-count">
            <strong id="panel-stock-count">—</strong> potes
          </p>
        </div>
        <p class="form-status" id="panel-stock-warning" data-kind="error" role="status" hidden></p>
        <form class="panel-stock-form" id="panel-stock-form">
          <label for="panel-stock-quantity">Potes</label>
          <input
            id="panel-stock-quantity"
            name="cantidad"
            type="number"
            step="1"
            required
            placeholder="50"
          />
          <label for="panel-stock-reason">Motivo</label>
          <input
            id="panel-stock-reason"
            name="motivo"
            required
            maxlength="200"
            placeholder="Producción nueva"
          />
          <button type="submit" class="btn primary">
            Registrar
          </button>
          <p class="form-status" id="panel-stock-status" role="status" hidden></p>
        </form>
        <details class="panel-stock-moves">
          <summary>Últimos movimientos</summary>
          <ul id="panel-stock-moves"></ul>
        </details>
      </section>

      <details class="panel-product" id="panel-product">
        <summary>
          <h2 id="panel-product-title">Producto y precios</h2>
        </summary>
        <p class="panel-product-note">
          Lo que guardes aquí cambia los precios y textos de la web la próxima vez que se publique.
          Los pedidos que ya llegaron conservan su precio.
        </p>
        <form class="panel-product-form" id="panel-product-form" novalidate>
          <div class="form-field full">
            <label for="product-presentacion">Presentación</label>
            <input id="product-presentacion" name="presentacion" required maxlength="60" />
          </div>
          <div class="form-field">
            <label for="product-precio">Precio por unidad (S/)</label>
            <input
              id="product-precio"
              name="precio"
              inputmode="decimal"
              required
              autocomplete="off"
            />
          </div>
          <div class="form-field">
            <label for="product-precio-mayor">Precio por mayor (S/)</label>
            <input
              id="product-precio-mayor"
              name="precio_mayor"
              inputmode="decimal"
              required
              autocomplete="off"
            />
          </div>
          <div class="form-field">
            <label for="product-minimo">Por mayor desde (unidades)</label>
            <input
              id="product-minimo"
              name="minimo_mayor"
              type="number"
              min="2"
              max="1000"
              step="1"
              required
            />
          </div>
          <div class="form-field full">
            <label for="product-corta">Descripción corta (portada)</label>
            <textarea
              id="product-corta"
              name="descripcion_corta"
              rows="3"
              maxlength="300"
              required
            ></textarea>
          </div>
          <div class="form-field full">
            <label for="product-google">Descripción para Google (50 a 160 caracteres)</label>
            <textarea
              id="product-google"
              name="descripcion_google"
              rows="3"
              maxlength="160"
              required
            ></textarea>
          </div>
          <div class="panel-product-actions full">
            <button type="submit" class="btn primary" disabled>
              Guardar cambios
            </button>
            <p class="form-status" id="panel-product-status" role="status" hidden></p>
          </div>
        </form>
        <details class="panel-product-changes">
          <summary>Últimos cambios</summary>
          <ul id="panel-product-changes"></ul>
        </details>
      </details>

      <section class="panel-sales" aria-labelledby="panel-sales-title">
        <h2 id="panel-sales-title">Resumen de ventas</h2>
        <div class="panel-sales-cards" id="panel-sales-cards"></div>
        <div class="panel-sales-grid">
          <table class="panel-sales-months">
            <caption>Últimos 6 meses</caption>
            <thead>
              <tr>
                <th scope="col">Mes</th>
                <th scope="col">Pedidos</th>
                <th scope="col">Potes</th>
                <th scope="col">Soles</th>
              </tr>
            </thead>
            <tbody id="panel-sales-months"></tbody>
          </table>
          <div>
            <h3>Ciudades que más compran</h3>
            <ol class="panel-sales-cities" id="panel-sales-cities"></ol>
          </div>
        </div>
        <p class="footnote">
          Cuenta los pedidos confirmados, pagados, enviados o entregados. Los montos son los
          estimados del pedido, sin el envío.
        </p>
      </section>

      <div class="panel-toolbar">
        <div
          class="panel-filters"
          id="panel-filters"
          role="group"
          aria-label="Filtrar por estado"
        ></div>
        <div class="panel-actions">
          <button type="button" class="btn ghost" id="panel-download" disabled>
            Descargar Excel
          </button>
          <button type="button" class="btn ghost" id="panel-refresh">
            Actualizar
          </button>
          <button type="button" class="btn ghost" id="panel-logout">
            Salir
          </button>
        </div>
      </div>
      <p class="form-status" id="panel-status" role="status" hidden></p>
      <ul class="panel-list" id="panel-list"></ul>
    </div>
  </section>
</PageLayout>

<script>
  import { initPanel } from '../scripts/panel';
  initPanel();
</script>
