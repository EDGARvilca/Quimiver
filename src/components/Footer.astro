---
import { pages } from '../config/pages';
import { complaintsBookEnabled, site, whatsappLink } from '../config/site';
import LogoMark from './LogoMark.astro';

const socialLinks = site.social.filter((s) => s.url !== null);
const buildYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div>
      <h2 class="footer-title">
        <LogoMark tone="oscuro" size={44} />
        <span>{site.brand}</span>
      </h2>
      <p>
        Producto creado por {site.company} para brindar bienestar natural a las familias peruanas.
      </p>
    </div>
    <div>
      <h3>Información</h3>
      <ul>
        <li>
          <a href={pages.product}>Producto</a>
        </li>
        <li>
          <a href={pages.about}>Nosotros</a>
        </li>
        <li>
          <a href={pages.shipping}>Envíos y pagos</a>
        </li>
        <li>
          <a href={pages.tracking}>Sigue tu pedido</a>
        </li>
        <li>
          <a href={pages.contact}>Contacto</a>
        </li>
        <li>
          <a href={pages.returns}>Cambios y devoluciones</a>
        </li>
        <li>
          <a href={pages.privacy}>Política de privacidad</a>
        </li>
        {complaintsBookEnabled && (
          <li>
            <a href={pages.complaints}>Libro de Reclamaciones</a>
          </li>
        )}
        <li>
          <a href={pages.faq}>Preguntas frecuentes</a>
        </li>
      </ul>
    </div>
    <div>
      <h3>Contacto</h3>
      <ul>
        <li>
          Teléfono: <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a>
        </li>
        <li>
          Correo: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li>
          WhatsApp:{' '}
          <a href={whatsappLink()} target="_blank" rel="noopener">
            Atención directa
          </a>
        </li>
      </ul>
    </div>
    {socialLinks.length > 0 && (
      <div>
        <h3>Síguenos</h3>
        <ul>
          {socialLinks.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
  {complaintsBookEnabled && (
    <a class="complaints-notice" href={pages.complaints}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28">
        <path
          fill="currentColor"
          d="M5 3h11a3 3 0 0 1 3 3v15H6a2 2 0 0 1-2-2V4a1 1 0 0 1 1-1Zm1 2v14h11V6a1 1 0 0 0-1-1H6Zm2 3h7v2H8V8Zm0 4h7v2H8v-2Z"
        ></path>
      </svg>
      <span>
        <strong>Libro de Reclamaciones</strong>
        Conforme a lo establecido en el Código de Protección y Defensa del Consumidor, contamos con
        un Libro de Reclamaciones virtual a tu disposición.
      </span>
    </a>
  )}
  <p class="footer-note">
    © <span id="current-year">{buildYear}</span>&nbsp;{site.company}. Todos los derechos reservados.
  </p>
</footer>

<script>
  const year = document.getElementById('current-year');
  if (year) {
    year.textContent = String(new Date().getFullYear());
  }
</script>
