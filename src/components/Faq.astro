---
import type { CollectionEntry } from 'astro:content';
import { fillPrices } from '../lib/product-data';

interface Props {
  product: CollectionEntry<'products'>['data'];
}

const { product } = Astro.props;
const faq = product.faq.filter((item) => item.verified);
---

<section class="section faq" id="faq">
  <div class="section-heading">
    <span class="eyebrow">Preguntas frecuentes</span>
    <h2>Todo lo que necesitas saber antes de comprar</h2>
  </div>
  <div class="faq-list">
    {faq.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{fillPrices(item.answer, product)}</p>
      </details>
    ))}
  </div>
</section>
