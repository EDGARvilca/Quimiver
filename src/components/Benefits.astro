---
import type { CollectionEntry } from 'astro:content';
import PendingNotice from './PendingNotice.astro';

interface Props {
  product: CollectionEntry<'products'>['data'];
}

const { product } = Astro.props;
const items = product.benefits.items.filter((b) => b.verified);
---

<section class="section features" id="beneficios">
  <div class="section-heading">
    <span class="eyebrow">¿Por qué elegirlo?</span>
    <h2>Beneficios de {product.name}</h2>
    {product.benefits.intro.verified && <p>{product.benefits.intro.text}</p>}
  </div>
  {items.length > 0 ? (
    <div class="cards-grid">
      {items.map((b) => (
        <article class="card">
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>
  ) : (
    <PendingNotice />
  )}
</section>
