---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>['data'];
}

const { product } = Astro.props;
const items = product.benefits.items.filter((b) => b.verified);
---

{items.length > 0 && (
  <section class="section features" id="beneficios">
    <div class="section-heading">
      <span class="eyebrow">¿Por qué elegirlo?</span>
      <h2>Beneficios de {product.name}</h2>
      {product.benefits.intro.verified && <p>{product.benefits.intro.text}</p>}
    </div>
    <div class="cards-grid">
      {items.map((b) => (
        <article class="card">
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>
  </section>
)}
