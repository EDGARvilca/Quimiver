---
/**
 * Sello de QUIMIVER (propuesta A, elegida por Hluot el 2026-10-06):
 * Q en círculo verde bosque con aro dorado y hoja de congona.
 * La Q va como trazo para verse igual aunque la fuente no haya cargado.
 */
interface Props {
  /** "claro" para fondos marfil; "oscuro" para fondos verde bosque. */
  tone?: 'claro' | 'oscuro';
  size?: number;
  class?: string;
}

const { tone = 'claro', size = 40, class: className } = Astro.props;
const dark = tone === 'oscuro';
const disc = dark ? '#f3efe4' : '#0f3a2d';
const ink = dark ? '#0f3a2d' : '#f3efe4';
const leaf = dark ? '#1b6e40' : '#7fbf8f';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="-70 -70 140 140"
  aria-hidden="true"
  focusable="false"
>
  <circle r="70" fill={disc}></circle>
  <circle r="61" fill="none" stroke="#a8834a" stroke-width="1.6"></circle>
  <path
