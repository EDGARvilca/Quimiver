---
import { inlineJson } from '../lib/json';
import type { CollectionEntry } from 'astro:content';
import { pages } from '../config/pages';
import { site } from '../config/site';
import { formatCurrency, type OrderConfig } from '../lib/order';

interface Props {
  product: CollectionEntry<'products'>['data'];
}

const { product } = Astro.props;

const config: OrderConfig = {
  productName: product.name,
  presentations: product.presentations,
  wholesaleMinQuantity: site.order.wholesaleMinQuantity,
  shippingOptions: [...site.order.shippingOptions],
  paymentMethods: site.payment.methods,
  paymentNumber: site.payment.number,
};

const minWholesale = site.order.wholesaleMinQuantity;
const singlePresentation = product.presentations.length === 1;
---

<section class="section order" id="compra">
  <div class="order-intro">
    <span class="eyebrow">Compra directa</span>
    <h2>Haz tu pedido de {product.name}</h2>
    <p>
      Completa el formulario y te contactaremos por WhatsApp o teléfono para confirmar el envío.
    </p>
    <ul class="price-list">
      {product.presentations.map((p) => (
        <li>
          {p.label}: <strong>{formatCurrency(p.price)}</strong> por unidad, o{' '}
          <strong>{formatCurrency(p.wholesalePrice)}</strong> por unidad desde {minWholesale}{' '}
          unidades.
        </li>
      ))}
    </ul>
  </div>

  <form class="order-form" id="order-form">
    <div class="form-field">
      <label for="customer-name">Nombre y apellido</label>
      <input
        type="text"
        id="customer-name"
        name="customer-name"
        required
        autocomplete="name"
        placeholder="Ej. Ana Torres"
      />
    </div>
    <div class="form-field">
      <label for="phone">Celular o WhatsApp</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder={`Ej. ${site.payment.number.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3')}`}
      />
    </div>
    <div class="form-field">
      <label for="city">Ciudad</label>
      <input
        type="text"
        id="city"
        name="city"
        required
        autocomplete="address-level2"
        placeholder="Ej. Huaraz"
      />
    </div>
    <div class="form-field">
      <label for="presentation">Presentación</label>
      <select id="presentation" name="presentation" required>
        <option value="" disabled selected={!singlePresentation}>
          Selecciona una opción
        </option>
        {product.presentations.map((p) => (
          <option value={p.id} selected={singlePresentation}>
            {p.label} — {formatCurrency(p.price)}
          </option>
        ))}
      </select>
    </div>
    <div class="form-field">
      <label for="quantity">Cantidad</label>
      <input type="number" id="quantity" name="quantity" value="1" min="1" step="1" required />
    </div>
    <div class="form-field">
      <label for="delivery">Tipo de entrega</label>
      <select id="delivery" name="delivery" required>
        <option value="" selected disabled>
          Selecciona una opción
        </option>
        {site.order.shippingOptions.map((s) => (
          <option value={s.id}>{s.label}</option>
        ))}
      </select>
    </div>
    <div class="form-field full">
      <label for="notes">Observaciones</label>
      <textarea
        id="notes"
        name="notes"
        rows="3"
        placeholder="Comparte más detalles o instrucciones de entrega"
      ></textarea>
    </div>

    <div class="form-summary">
      <p>
        Total estimado:{' '}
        <strong id="order-total" aria-live="polite">
          {formatCurrency(0)}
        </strong>
      </p>
      <p class="footnote">
        Desde {minWholesale} unidades se aplica el precio por mayor. El costo de envío depende de la
        zona o del destino y te lo confirmamos por WhatsApp.
      </p>
    </div>

    <div class="visually-hidden" aria-hidden="true">
      <label for="order-sitio-web">No llenar</label>
      <input id="order-sitio-web" name="sitio_web" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-field full form-consent">
      <input type="checkbox" id="privacy-consent" name="privacy-consent" required />
      <label for="privacy-consent">
        Acepto que {site.company} use mis datos para atender este pedido, según la{' '}
        <a class="text-link" href={pages.privacy} target="_blank" rel="noopener">
          política de privacidad
        </a>
        .
      </label>
    </div>

    <p id="order-status" class="form-status" role="status" aria-live="polite" hidden></p>

    <button type="submit" class="btn primary full">
      Confirmar pedido
    </button>
  </form>
  <script type="application/json" id="order-config" set:html={inlineJson(config)} />
</section>

<script>
  import { initOrderForm } from '../scripts/order-form';
  initOrderForm();
</script>
