---
import type { CollectionEntry } from 'astro:content';
import { assetUrl } from '../lib/paths';
import SiteHeader from './SiteHeader.astro';

interface Props {
  product: CollectionEntry<'products'>['data'];
}

const { product } = Astro.props;
---

<header class="hero" id="inicio">
  <picture class="hero-backdrop" data-depth="0.12">
    <source
      media="(max-width: 768px)"
      srcset={assetUrl('/images/portada-movil.webp')}
      width="752"
      height="941"
    />
    <img
      src={assetUrl('/images/portada.webp')}
      srcset={`${assetUrl('/images/portada-960.webp')} 960w, ${assetUrl('/images/portada.webp')} 1672w`}
      sizes="100vw"
      alt="Frasco de crema con tapa verde sobre una piedra clara, rodeado de hojas verdes"
      width="1672"
      height="941"
      fetchpriority="high"
    />
  </picture>
  <SiteHeader />

  <div class="hero-content">
    <div class="hero-text">
      <span class="eyebrow">
        {product.descriptor} · {product.manufacturer}
      </span>
      {product.badge.verified && <span class="badge">{product.badge.text}</span>}
      <h1>
        {product.name}
        <span class="hero-subtitle">{product.descriptor}</span>
      </h1>
      <p>
        {product.intro}
        {product.summary.verified && ` ${product.summary.text}`}
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#compra">
          Realizar pedido
        </a>
        <a class="btn ghost" href="#producto">
          Conocer el producto
        </a>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#producto">
    <span>Desliza para descubrir</span>
  </a>
  <small class="image-note">Imagen referencial</small>
</header>
