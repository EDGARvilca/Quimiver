---
import { inlineJson } from '../lib/json';
import '../styles/global.scss';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import displayFont from '../assets/fonts/cormorant-garamond-latin-500-normal.woff2?url';
import bodyFont from '../assets/fonts/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Datos estructurados JSON-LD opcionales. */
  jsonLd?: Record<string, unknown>;
  /** Páginas privadas (panel): que Google no las muestre. */
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(withBase('/images/quimiver-compartir.jpg'), Astro.site).href
  : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <script is:inline>
      // Marca temprana para que el menú móvil se pinte ya plegado y la página no salte.
      document.documentElement.classList.add('js');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={inlineJson(jsonLd)} />}
  </head>
  <body>
    <slot />
    <script>
      import { initDepth } from '../scripts/depth';
      import { initStory } from '../scripts/story';
      initDepth();
      initStory();
    </script>
  </body>
</html>
